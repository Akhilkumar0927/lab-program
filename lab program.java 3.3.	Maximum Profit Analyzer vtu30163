import java.util.Scanner;

public class MaximumProfitAnalyzer {

    /**
     * Finds the maximum profit achievable from a single buy-sell transaction.
     * Buy must happen before sell.
     *
     * @param prices array of stock prices indexed by day
     * @return maximum profit (0 if no profit is possible)
     */
    public static int maxProfit(int[] prices) {
        if (prices == null || prices.length < 2) {
            return 0;
        }

        int minPrice = prices[0];
        int maxProfit = 0;

        for (int i = 1; i < prices.length; i++) {
            // Track the lowest price seen so far
            if (prices[i] < minPrice) {
                minPrice = prices[i];
            } else if (prices[i] - minPrice > maxProfit) {
                // Update max profit if selling today beats previous best
                maxProfit = prices[i] - minPrice;
            }
        }

        return maxProfit;
    }

    /**
     * Bonus: returns the best day to buy and best day to sell (0-indexed).
     */
    public static int[] maxProfitWithDays(int[] prices) {
        int buyDay = 0, sellDay = 0, minIndex = 0;
        int maxProfit = 0;

        for (int i = 1; i < prices.length; i++) {
            if (prices[i] < prices[minIndex]) {
                minIndex = i;
            } else if (prices[i] - prices[minIndex] > maxProfit) {
                maxProfit = prices[i] - prices[minIndex];
                buyDay = minIndex;
                sellDay = i;
            }
        }

        return new int[]{buyDay, sellDay, maxProfit};
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("=== Maximum Profit Analyzer ===");
        System.out.print("Enter number of days: ");
        int n = sc.nextInt();

        int[] prices = new int[n];
        System.out.println("Enter price for each day:");
        for (int i = 0; i < n; i++) {
            prices[i] = sc.nextInt();
        }

        int profit = maxProfit(prices);
        int[] result = maxProfitWithDays(prices);

        System.out.println("\n--- Analysis Result ---");
        if (profit == 0) {
            System.out.println("No profitable transaction possible.");
        } else {
            System.out.println("Maximum Profit: " + profit);
            System.out.println("Buy on Day: " + (result[0] + 1) + " (Price: " + prices[result[0]] + ")");
            System.out.println("Sell on Day: " + (result[1] + 1) + " (Price: " + prices[result[1]] + ")");
        }

        sc.close();
    }
}
